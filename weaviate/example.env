QUERY_DEFAULTS_LIMIT=25
PERSISTENCE_DATA_PATH='/var/lib/weaviate'
DEFAULT_VECTORIZER_MODULE='none'
CLUSTER_HOSTNAME='juddges-vm'

# modules (vectorization done externally via TEI, only backup module needed)
ENABLE_MODULES='backup-filesystem'
BACKUP_FILESYSTEM_PATH='/var/lib/weaviate-backups'

# authentication
AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
AUTHENTICATION_APIKEY_ENABLED=true
AUTHENTICATION_APIKEY_ALLOWED_KEYS='<API_KEY>'
AUTHENTICATION_APIKEY_USERS='<USER_NAME>'

# Embedding model (external TEI service, not Weaviate module)
EMBEDDING_MODEL='Qwen/Qwen3-Embedding-0.6B'
EMBEDDING_DIM=128
