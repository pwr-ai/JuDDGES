# Copy to .env (gitignored) and fill in the secrets.

# --- Weaviate authentication ---
AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
AUTHENTICATION_APIKEY_ENABLED=true
AUTHENTICATION_APIKEY_ALLOWED_KEYS='<API_KEY>'
AUTHENTICATION_APIKEY_USERS='<USER_NAME>'

# --- Networking (host side) ---
# 127.0.0.1 keeps the stack local; set 0.0.0.0 only behind a firewall / reverse proxy
WEAVIATE_BIND=127.0.0.1
WEAVIATE_HTTP_PORT=8110
WEAVIATE_GRPC_PORT=50061
EMBEDDINGS_PORT=8111

# --- Resources ---
WEAVIATE_CPUS=32
WEAVIATE_MEMORY=128G
WEAVIATE_GOMEMLIMIT=100GiB
WEAVIATE_BACKUP_DIR=./backups

# --- Embeddings (TEI) ---
# Prefix inputs with "query: " / "passage: " (TEI adds no prompts for this model)
EMBEDDING_MODEL=sdadas/mmlw-retrieval-e5-large
EMBEDDING_DIM=1024
EMBEDDINGS_GPU=0
HF_TOKEN=
