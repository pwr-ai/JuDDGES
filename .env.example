# JuDDGES environment variables (template)
#
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is gitignored (see .gitignore: `*.env`) — never commit real secrets.

# --- Weaviate ---------------------------------------------------------------
# API key for the Weaviate instance the ingestion / query scripts talk to.
# Required by: docker_ingest.py, scripts/demos/*.py, weaviate/*.py
WEAVIATE_API_KEY=

# Weaviate HTTP endpoint. Default for local docker-compose is http://localhost:8084.
WEAVIATE_URL=http://localhost:8084

# --- Local Postgres (optional, dev only) -----------------------------------
# Override for juddges/settings.py LOCAL_POSTGRES default.
# LOCAL_POSTGRES_URL=postgresql+psycopg2://llm:llm@localhost:3456/llm

# --- Hugging Face (optional) -----------------------------------------------
# Required when pulling gated models or pushing artifacts.
# HUGGING_FACE_HUB_TOKEN=

# --- LLM providers (optional) ----------------------------------------------
# Set whichever you actually use; leave the rest blank.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
