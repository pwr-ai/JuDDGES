  "flagWords": [],
  "ignorePaths": [
    "node_modules/**",
    ".venv/**",
    ".git/**",
    "dist/**",
    "build/**",
    "site/**",
    "*.pyc",
    "__pycache__/**",
    ".cache/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**",
    "*.lock",
    "dvc.lock",
    "*.min.js",
    "*.min.css",
    "package-lock.json"
  ],
  "patterns": [
    {
      "name": "Email",
      "pattern": "/\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b/g"
    },
    {
      "name": "URL",
      "pattern": "/https?:\\/\\/[^\\s]+/g"
    },
    {
      "name": "UUID",
      "pattern": "/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/gi"
    },
    {
      "name": "Hex",
      "pattern": "/0x[0-9A-Fa-f]+/g"
    },
    {
      "name": "Git SHA",
      "pattern": "/[0-9a-f]{7,40}/g"
    }
  ],
  "dictionaries": [
    "en",
    "python",
    "softwareTerms",
    "companies"
  ],
  "enableFiletypes": [
    "markdown",
    "text"
  ],
  "ignoreCasesInWords": true,
  "allowCompoundWords": true,
  "minWordLength": 4
}
